# Development example only. Copy to .env and replace values locally.
SENTINELWEB_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/sentinelweb
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173

# Configure only while provisioning the first admin, then remove/rotate it.
ADMIN_BOOTSTRAP_SECRET=replace-with-an-independent-random-secret-at-least-32-characters

AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOCKOUT_SECONDS=900
ATTACK_PAYLOAD_EVIDENCE_CHARS=4096

# The WAF is a fixed-destination proxy. Keep the intentionally vulnerable testbed local.
WAF_UPSTREAM_URL=http://127.0.0.1:9000
WAF_UPSTREAM_ALLOWED_HOSTS=127.0.0.1,localhost
WAF_UPSTREAM_TIMEOUT_SECONDS=5
WAF_MAX_REQUEST_BODY_BYTES=65536
WAF_MAX_UPSTREAM_RESPONSE_BYTES=1048576
WAF_MAX_URL_BYTES=8192
WAF_MAX_HEADER_BYTES=32768
WAF_MAX_JSON_DEPTH=20
WAF_MAX_FORM_FIELDS=200
WAF_MAX_CONCURRENT_REQUESTS=100

# Empty by default: forwarding headers are ignored unless the socket peer is listed.
# Use explicit proxy addresses/CIDRs only, for example 10.20.0.5,10.30.0.0/24.
TRUSTED_PROXY_IPS=
ADAPTIVE_RISK_WINDOW_MINUTES=15
ADAPTIVE_RISK_MAX_HISTORY=200
REPORT_MAX_ENTRIES=5000
